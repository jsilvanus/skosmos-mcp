SKOSMOS_BASE_URL=https://api.finto.fi
SKOSMOS_DEFAULT_VOCABULARY=
SKOSMOS_DEFAULT_LANGUAGE=en
SKOSMOS_TIMEOUT=30000
SKOSMOS_USER_AGENT=skosmos-mcp/0.2.1
SKOSMOS_CACHE_TTL=300
SKOSMOS_MAX_TRAVERSAL_DEPTH=5
SKOSMOS_TOOL_SERVER_URL_ALLOWED=true
MCP_HTTP_PORT=3000
MCP_HTTP_HOST=127.0.0.1

# SPARQL Configuration
SPARQL_ENDPOINT_URL=https://api.finto.fi/sparql
SPARQL_USERNAME=
SPARQL_PASSWORD=
SPARQL_ALLOW_OTHER_ENDPOINTS=true

# OAuth + OIDC sign-in for the HTTP server (optional; leave OIDC_ISSUER empty to keep /mcp open)
# See README "OAuth and OIDC sign-in". Redirect URI to register at the IdP: <MCP_PUBLIC_URL>/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_BUTTON_LABEL=Sign in with single sign-on
MCP_PUBLIC_URL=
# base64, >= 32 bytes: openssl rand -base64 32
JWT_SECRET=
MCP_TRUST_PROXY=
